# olake-ask configuration. Copy to .env (git-ignored); real environment variables always win.

# --- Secrets ---------------------------------------------------------------
# LLM key (OpenRouter: sk-or-v1-...). The only LLM setting you need; everything below defaults to OpenRouter.
# Empty = the server runs in permanent search_only mode. LLM_API_KEY is still read if this is unset.
OPENROUTER_API_KEY=
# GitHub token for the seeder (optional; without it issue comments are capped).
GITHUB_TOKEN=
# Embedding API key: for EMBEDDER=api, or for the optional Cohere vectors (see EMBED_API below).
EMBED_API_KEY=

# --- LLM (server) ----------------------------------------------------------
# openai_compatible | anthropic
LLM_PROVIDER=openai_compatible
# Default https://openrouter.ai/api/v1 (openai_compatible) or https://api.anthropic.com (anthropic).
LLM_BASE_URL=
# Default z-ai/glm-4.7-flash for openai_compatible; required for anthropic.
LLM_MODEL=
# Comma list sent as OpenRouter's `models`: tried in order, in the same call, if LLM_MODEL errors.
# You are billed for whichever model answers. Default (openai_compatible):
# google/gemini-2.5-flash-lite,deepseek/deepseek-v4.1-flash. Set to none to disable.
LLM_FALLBACK_MODELS=
# Optional second model on the same provider, tried as a separate call if the answer call fails.
# Leave empty when LLM_FALLBACK_MODELS is set.
LLM_FALLBACK_MODEL=
# OpenRouter reasoning effort: none | minimal | low | medium | high | xhigh | default (don't send).
# none = faster, cheaper answers; dropped automatically if a model rejects it.
LLM_REASONING_EFFORT=

# --- Embeddings ------------------------------------------------------------
# Seeder only: model2vec | api | none (the server follows the bundle manifest).
EMBEDDER=model2vec
# go-potion model (BASE2M, BASE4M, BASE8M, BASE32M, RETRIEVAL32M, CODE16MV2, ...) or API model name.
EMBED_MODEL=RETRIEVAL32M
# OpenAI-compatible embeddings base URL (only for EMBEDDER=api).
EMBED_BASE_URL=
# Optional Cohere vectors next to the local ones: auto | off.
# auto = the seeder builds them when EMBED_API_MODEL and EMBED_API_KEY are set (EMBEDDER=model2vec),
# and the server uses them when the bundle has them and EMBED_API_KEY is set; any Cohere failure
# falls back to the local vectors. off = local vectors only.
EMBED_API=auto
# Seeder: Cohere model (e.g. embed-v4.0); empty = no Cohere vectors.
EMBED_API_MODEL=
# Seeder: Cohere output_dimension (0 = model default).
EMBED_API_DIM=0
# Cohere v2 base URL.
EMBED_API_BASE_URL=https://api.cohere.com/v2

# --- Retrieval & answering (server) -----------------------------------------
# Vector search backend: memory (exact cosine) is the only option.
VECTOR_BACKEND=memory
# Extra LLM call to rewrite queries: off | when_needed | always
REWRITE=off
# Extra LLM call to rerank passages: off | on
RERANK=off
# Daily LLM token budget (UTC day); 0 = unlimited.
DAILY_TOKEN_BUDGET=5000000

# --- HTTP (server) ---------------------------------------------------------
# CORS: "*" = every origin (default, so the widget works on any site), or a comma list; ':*' allows any port.
ALLOWED_ORIGINS=*
# Listen port (Render sets this).
PORT=8080
# Local debugging: on prints every request sent to the LLM (method, URL, indented JSON body; never headers/keys).
DEBUG=off

# --- Seeder ----------------------------------------------------------------
# Include closed GitHub issues with maintainer replies: on | off
SEED_ISSUES=on
